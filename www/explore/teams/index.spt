[-----------------------------]

teams = website.db.all("""

    SELECT t.*::teams
      FROM teams t
  ORDER BY slug DESC

""")
nteams = len(teams)
title = _("Explore")
subhead = _("Teams")

[-----------------------------] text/html
{% extends "templates/explore.html" %}

{% block content %}
<h2>{{ _("Teams (N={0})", nteams) }}</h2>
<table class="table">
    <tr>
        <th>{{ _("Team Name") }}</th>
    </tr>
    {% for team in teams %}
    <tr>
        <td class=""><a href="/{{ team.slug}}/">{{ team.display_name }}</a></td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
