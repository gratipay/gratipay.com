from aspen import Response
[---]
if user.ANON:
    raise Response(401)
if not user.ADMIN:
    raise Response(403)
[---] text/html
<!doctype html>
<html>
    <title>Dashboard</title>
    <link rel="stylesheet" type="text/css" href="{{ website.asset('dashboard.css') }}" />
    <link rel="stylesheet" type="text/css" href="//cloud.typography.com/6540672/615104/css/fonts.css" />
    <script src="{{ website.asset('jquery.min.js') }}"></script>
    <script src="{{ website.asset('underscore-min.js') }}"></script>
    <script src="{{ website.asset('backbone-min.js') }}"></script>
    <script src="{{ website.asset('dashboard.js') }}"></script>
    <script>
        $(document).ready(Dashboard.init);
    </script>
</head>
<body id="dashboard">
    <h1>Dashboard</h1>
    <ul id="navigation">
        <li><a href="statements">Statements</a></li>
        <li><a href="ledgers">Ledgers</a></li>
        <li><a href="journals">Journals</a></li>
    </ul>

    <section id="general-ledger">
        <h2>General Ledger</h2>
        <div id="sidebar">
            <ul class="nav">
                <li><a href="ledgers/general" class="selected">General</a></li>
            </ul>
        </div>
        <table>
            <thead>
                <th>Account</th>
                <th>Debits</th>
                <th>Credits</th>
            </thead>
            <tfoot></tfoot>
            <tbody></tbody>
        </table>
    </section>

    <section id="chart-of-accounts">
        <h2>Chart of Accounts</h2>
        <table>
            <thead>
                <th>Number</th>
                <th>Name</th>
            </thead>
            <tfoot></tfoot>
            <tbody></tbody>
        </table>
    </section>

    <script type="text/template" id="AccountRow">
        <td class="number">
            <span class="view"><%= number %></span>
            <input class="edit" name="number" value="<%= number %>">
        </td>
        <td class="name">
            <span class="view"><%= name %></span>
            <input class="edit" name="name" value="<%= name %>">
        </td>
    </script>

    <script type="text/template" id="AddAccount">
        <tr class="off buttons">
            <td colspan="2">
                <button>Add Account</button>
            </td>
        </tr>
        <tr class="on">
            <td class="number"><input type="text" name="number"></td>
            <td class="name"><input type="text" name="name"></td>
        </tr>
        <tr class="on buttons">
            <td colspan="2">
                <button type="submit">Add Account</button>
                <button type="cancel">Done</button>
            </td>
        </tr>
    </script>
</body>
</html>
