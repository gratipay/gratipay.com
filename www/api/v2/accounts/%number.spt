import re
from aspen import Response
from psycopg2 import IntegrityError

number_re = re.compile(r'^[0-9-]{3,32}$')
name_re = re.compile(r'^[A-Za-z0-9 ~-]{3,32}$')
[---]
if user.ANON:       raise Response(401)
if not user.ADMIN:  raise Response(403)

request.allow('GET', 'PUT')

number = request.path['number']
if not number_re.match(number):
    raise Response(404)

if request.method == 'PUT':
    name = request.body.get('name')
    if not name_re.match(name):
        raise Response(400, 'Invalid name.')
    with website.db.get_cursor() as c:
        try:
            website.db.run("INSERT INTO accounts (number, name) VALUES (%s, %s)", (number, name))
        except IntegrityError:
            try:
                _number = website.db.one("UPDATE accounts SET name=%s WHERE number=%s "
                                         "RETURNING number", (name, number))
                if _number is None:
                    raise Response(400, "Failed to upsert ({}, {}). Probably a duplicate name?"
                                        .format(number, name))
            except IntegrityError, err:
                raise Response(400, err.args[0])

out = website.db.one("SELECT * FROM accounts WHERE number=%s", (number,))
if out is None:
    raise Response(404)
[---] application/json via json_dump
out
